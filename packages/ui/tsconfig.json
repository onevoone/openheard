{
  "extends": "@openheard/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    // Paraglide's compiled messages are JS with JSDoc types.
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@openheard/ui/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
